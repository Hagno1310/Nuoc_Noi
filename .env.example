# Chép thành .env.local rồi điền. Không commit .env.local.

# Supabase: lấy từ `npx supabase status -o env` (local) hoặc Supabase → Project Settings → API (production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ scripts/ đọc biến này (create-user). Không đặt lên Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Phải trùng email tài khoản staff tạo bằng `npm run create-user -- staff ...`
NEXT_PUBLIC_STAFF_EMAIL=nhanvien@quan.local

# Cloudinary (ảnh chuyển khoản): Cloudinary → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Hai biến dưới là bí mật, chỉ route /api/transfer-photo/sign đọc. Không thêm tiền tố NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Heartbeat Supabase (Vercel Cron): chuỗi ngẫu nhiên ≥ 16 ký tự, ví dụ `openssl rand -hex 32`. Chỉ /api/heartbeat đọc.
CRON_SECRET=
